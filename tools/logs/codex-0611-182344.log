+
+    fireEvent.click(screen.getByRole('button', { name: 'Edit' }))
+    rerender(<App />)
+
+    expect(useNavigationStore.getState().currentView).toBe('edit')
+    expect(screen.getByRole('heading', { name: 'Edit' })).toBeDefined()
+  })
+})
